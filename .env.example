# Copy this file to .env and fill in real values. Never commit .env.

# development | production | test
NODE_ENV=development

# Port the API listens on
PORT=5000

# MongoDB connection string (local MongoDB or a MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/jobconnect

# Frontend origin(s) allowed to call the API (comma-separated for several)
CORS_ORIGIN=http://localhost:5173

# Secret used to sign login tokens (JWTs). Use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login lasts before the user must sign in again (e.g. 15m, 1d, 7d)
JWT_EXPIRES_IN=1d

# bcrypt cost factor (higher = slower to hash and to brute-force)
BCRYPT_SALT_ROUNDS=12
