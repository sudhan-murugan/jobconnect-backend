{
  "name": "jobconnect-backend",
  "version": "1.0.0",
  "description": "REST API for JobConnect — a job portal where recruiters post jobs and job seekers search and apply.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "job-portal"
  ],
  "author": "sudhan-murugan",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "swagger-ui-express": "^5.0.1"
  },
  "allowScripts": {
    "bcrypt": true,
    "@scarf/scarf": false,
    "mongodb-memory-server": false,
    "@parcel/watcher": false
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
